# Server configuration
PORT=4000
FRONTEND_URL=http://localhost:3000

# Required for Prisma commands and the database health probe. Replace USER and PASSWORD locally.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/interview_readiness_engine?schema=public"

# Required for authentication. Use a high-entropy value of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-development-secret-at-least-32-characters

# Reserved for later phases.
OPENAI_API_KEY=
